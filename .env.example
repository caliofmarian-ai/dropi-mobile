# DROPi — Variabile de Mediu necesare
# Copiază acest fișier în .env și completează valorile
# NICIODATĂ nu comite .env în Git (este în .gitignore)

# ──────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────
# MySQL connection string
# Railway: furnizat automat după adăugarea plugin-ului MySQL
# Format: ******host:3306/dbname
DATABASE_URL=******host:3306/dropi

# ──────────────────────────────────────────
# AUTHENTICATION
# ──────────────────────────────────────────
# Secret pentru semnarea JWT tokens (minim 32 caractere random)
# Generare: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ──────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────
# Port server (Railway îl injectează automat ca $PORT)
PORT=3000

# Mediu: development | production
NODE_ENV=production

# ──────────────────────────────────────────
# OAUTH (opțional - pentru Manus OAuth flow)
# ──────────────────────────────────────────
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
EXPO_PUBLIC_API_BASE_URL=

# ──────────────────────────────────────────
# AI / FORGE API (opțional - pentru agenți AI)
# ──────────────────────────────────────────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ──────────────────────────────────────────
# STORAGE (opțional - pentru upload imagini)
# ──────────────────────────────────────────
# S3-compatible storage (ex: Cloudflare R2, AWS S3)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# ──────────────────────────────────────────
# EMAIL
# ──────────────────────────────────────────
# Preferred on Railway Hobby: HTTPS transactional email.
# RESEND_API_KEY is a server-only secret. Never expose it through EXPO_PUBLIC_*.
# Until a DROPi domain is verified, Resend's development sender can be used for
# delivery to the email address associated with the Resend account.
RESEND_API_KEY=
RESEND_FROM="DROPi Platform <onboarding@resend.dev>"

# Optional SMTP/Gmail fallback. Useful on infrastructure that permits outbound
# SMTP; RESEND_API_KEY takes precedence when both transports are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GMAIL_APP_PASSWORD=
SMTP_FROM=

# ──────────────────────────────────────────
# ADMIN PROVISIONING (one-time bootstrap)
# ──────────────────────────────────────────
# Used ONLY by: node dist/provision-admin.mjs
# Run once after the first Railway deployment to create the system administrator.
# NEVER commit these values. Remove from Railway env after provisioning is complete.
# See docs/ADMIN_PROVISIONING.md for the full procedure.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin
