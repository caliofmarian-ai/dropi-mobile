# DROPi — Variabile de Mediu necesare
# Copiază acest fișier în .env și completează valorile
# NICIODATĂ nu comite .env în Git (este în .gitignore)

# ──────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────
# MySQL connection string
# Railway: furnizat automat după adăugarea plugin-ului MySQL
# Format: ******host:3306/dbname
DATABASE_URL=******host:3306/dropi

# ──────────────────────────────────────────
# AUTHENTICATION
# ──────────────────────────────────────────
# Secret pentru semnarea JWT tokens (minim 32 caractere random)
# Generare: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ──────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────
# Port server (Railway îl injectează automat ca $PORT)
PORT=3000

# Mediu: development | production
NODE_ENV=production

# ──────────────────────────────────────────
# OAUTH (opțional - pentru Manus OAuth flow)
# ──────────────────────────────────────────
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
EXPO_PUBLIC_API_BASE_URL=

# ──────────────────────────────────────────
# AI / FORGE API (opțional - pentru agenți AI)
# ──────────────────────────────────────────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ──────────────────────────────────────────
# STORAGE (opțional - pentru upload imagini)
# ──────────────────────────────────────────
# S3-compatible storage (ex: Cloudflare R2, AWS S3)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# ──────────────────────────────────────────
# EMAIL — RESEND HTTPS ONLY
# ──────────────────────────────────────────
# DROPi recovery/verification email is sent only through the Resend HTTPS API.
# Both values are server-only and required. There is no SMTP/Gmail fallback.
# Never expose RESEND_API_KEY through EXPO_PUBLIC_* and never commit a real value.
RESEND_API_KEY=
RESEND_FROM="DROPi Platform <onboarding@resend.dev>"

# ──────────────────────────────────────────
# ADMIN PROVISIONING (one-time bootstrap)
# ──────────────────────────────────────────
# Used ONLY by: node dist/provision-admin.mjs
# Run once after the first Railway deployment to create the system administrator.
# NEVER commit these values. Remove from Railway env after provisioning is complete.
# See docs/ADMIN_PROVISIONING.md for the full procedure.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin

# ──────────────────────────────────────────
# IMPL-008 TEST-ROLE PROVISIONING
# ──────────────────────────────────────────
# Used ONLY by: pnpm db:provision-test-accounts
# The provisioner creates/reconciles 29 human + 29 AI mirror identities derived
# from the canonical ROLE_CONFIGS registry and materializes each AI humanPairId.
#
# Keep provisioning disabled except during a controlled development/staging run.
# DROPI_TEST_ACCOUNT_PASSWORD is server-only; never expose it through
# EXPO_PUBLIC_* and never commit a real value.
DROPI_TEST_ACCOUNT_PROVISIONING=
DROPI_TEST_ACCOUNT_PASSWORD=
DROPI_TEST_ACCOUNT_ZONE=
